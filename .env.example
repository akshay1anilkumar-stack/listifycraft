# Three-key Gemini pool. Configure at least one key; all three are supported.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Backward-compatible optional single key
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=2K
AI_MODEL_CREDIT_COST=1

SESSION_SECRET=replace-with-at-least-32-random-bytes
INITIAL_ADMIN_USERNAME=master_admin
INITIAL_ADMIN_PASSWORD=AdminOwner2026!
# Optional: use a pre-generated scrypt hash instead of INITIAL_ADMIN_PASSWORD
INITIAL_ADMIN_PASSWORD_HASH=

SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_INVENTORY_LOCATION_ID=gid://shopify/Location/your-location-id
SHOPIFY_DEFAULT_VENDOR=ListifyCraft

# Defaults to src/data/listing-studio.sqlite
DATABASE_PATH=
PORT=3000
APP_DOMAIN=https://www.listifycraft.com
